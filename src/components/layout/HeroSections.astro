---
const { title } = Astro.props;
import Layout from "../../layouts/Layout.astro";
---

<Layout>
    <section class="hero">
        <div class="hero__text">
            <div class="text__superior">
                <img src="../img/arrow-yellow.svg" alt="icono check" class="superior__icon">
                <p class="superior__p">Ruta que combina espiritualidad, natureza, patrimonio e identidad rural.</p>       
            </div>
            <h1 class="text__h1">{title}</h1>
            <p class="inferior__p">Una escapada donde el patrimonio, la cultura y la religiosidad se convierten en una experiencia inolvidable.</p>
        </div> 
    </section>
</Layout>

<style>
   /* ===== HEADER BANNER ===== */
  .hero {
    width: 100%;
    height: clamp(55vh, 45vw, 70vh);
    background-image: url(..//img/image.webp);
    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;
  }

.hero__text {
  width: 45rem;
  height: auto;
  display: flex;
  justify-content: flex-start;
  flex-direction: column;
  padding-left: 5rem;
  padding-top: 14rem;
  gap: 2rem;
  align-items: flex-start;
}

  .text__superior {
    width: 22rem;
    height: auto;
    display: flex;
    gap: 0.5rem;
    justify-content: left;
    align-items: center;
  }

  .superior__icon {
    width: 15px;
    height: 15px;
  }

.superior__p {
  font-family: var(--font-tertiary);
  height: 64px;
  font-size: 13px;
  font-weight: 500;
  color: var(--light);
  display: flex;
  align-items: center;
}

.text__h1 {
  font-family: var(--font-secondary);
  font-size: 55px;
  height: 64px;
  font-weight: 400;
  color: var(--light);
  text-transform: uppercase;
  display: flex;
  align-items: center;
  margin-left: 20px;
}

.inferior__p {
  width: 37rem;
  height: 64px;
  font-family: var(--font-primary);
  font-size: 16px;
  line-height: 25px;
  color: var(--light);
  display: flex;
  align-items: center;
  margin-left: 20px;
}

    /*MEDIA QUERY*/

    /*1920PX*/

    @media (min-width: 1920px) {
        .hero__text {
            width: 50vw;
            height: auto;
            padding-left: 8rem;
            padding-top: 19rem;
        }

        .text__superior {
            width: 24vw;
        }

        .superior__icon {
            width: 18px;
            height: 18px;
        }

        .superior__p {
            font-size: 17px;
        }

        .text__h1 {
            height: auto;
            width: 50vw;
            font-size: 90px;
        }

        .inferior__p {
            width: 40vw;
            font-size: 19px;
        }
    }



@media (max-width: 768px) {
  .hero__text {
    width: 90%;
  }

  .text__superior {
    width: 100%;
  }

  .inferior__p {
    width: 100%;
  }
}

@media (max-width: 480px) {
  .hero__text {
    width: 90%;
    padding-left: 4.5rem;
    gap: 1rem;
  }

  .text__superior {
    width: 100%;
  }

  .text__h1 {
    font-size: 42px;
  }

        .inferior__p {
            width: 70vw;
            font-size: 11px;
            line-height: 20px;
            text-align: center;
        }
    }

    @media (min-width:320px) {
        .text__superior {
            width: 70vw;
        }

    }
</style>
