---
const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width">
		<link rel="icon" href="/favicon.png">
		<meta name="generator" content={Astro.generator}>

		    <slot name="head">
      			<title>{title}</title>
    		</slot>
<!-- 		<title>Via Mariana - Ruta luso-galaica</title>
 -->		
		<meta name="description" content="Esta es la página de Via Mariana">
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@12/swiper-bundle.min.css" />

		<!-- Open Graph General (Facebook, LinkedIn, etc.) -->
<meta property="og:title" content="Vía Mariana un referente cultural,espiritual y turístico gallego-portugués" />
<meta property="og:description" content="La Vía Mariana es una ruta de peregrinación que une braga con Muxía donde se combina camino espiritual, ruta cultural, itinerario de naturaleza e identidad rural; se presenta como una opción diferenciada respecto al camino de Santiago. Su objetivo es vivir el camino como un proceso de descubrimiento espiritual, cultural y humano.
Una propuesta de encuentro, reconocimiento mutuo y de activación territorial.
Un camino de vivencias que ofrece tiempo, silencio y una conexión personal y con otros.
Gracias a su naturaleza hibrida el camino está impregnado de leyendas y milagros locales, cantos y música tradicional, hospitalidad rural, cultura popular, relatos de peregrinación y fe, iglesias románicas y barrocas, cruceros, caminos reales, castros, …" />
<meta property="og:type" content="website" />
<meta property="og:url" content="https://viamarianalusogalaica.eu/" />
<meta property="og:image" content="https://via-mariana.netlify.app/img/imgOpenGraph.webp" />
<meta property="og:site_name" content="Via Mariana Luso-Galaica" />
<meta property="og:locale" content="es_ES" />

<!-- Etiquetas específicas para Twitter (X) -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content="Via Mariana Luso-Galaica" />
<meta name="twitter:description" content="Ruta Via Mariana Luso-Galaica" />
<meta name="twitter:image" content="https://viamarianalusogalaica.eu/" />

	</head>
	<body>
		<slot />
		
		 <script defer src="https://cdn.jsdelivr.net/npm/swiper@12/swiper-bundle.min.js"></script>
		  <!-- <script client src="https://cdn.jsdelivr.net/npm/swiper@12/swiper-bundle.min.js"></script> -->
	</body>
</html>

<style is:global>
	* {
		margin: 0;
		padding: 0;
		outline: 0;
		box-sizing: border-box;
	}

	html {
		font-size: 14px;
		scroll-behavior: smooth;
	}

	@font-face {
		font-family: Poppins-Regular;
		src: url(/fonts/Poppins-Regular.ttf);
	}

	@font-face {
		font-family: Poppins-Medium;
		src: url(/fonts/Poppins-Medium.ttf);
	}

	@font-face {
		font-family: OpenSans;
		src: url(/fonts/OpenSans-VariableFont_wdth.ttf);
	}

	:root {
		--font-primary: Poppins-Regular;
		--font-secondary: Poppins-Medium;
		--font-tertiary: OpenSans;
		--color-primary: #00378f;
		--color-secondary: #efb91f;
		--color-tertiary: #f8f9fb;
		--grey: #7f7f7f;
		--light: #ffffff;
		--dark: #1a1a1a;
	}

	body {
		background: var(--light);
		color: var(--dark);
		-webkit-font-smoothing: antialiased;
	}

	body, input, button {
		font-family: var(--font-primary);
	}

	button {
		cursor: pointer;
	}
</style>
